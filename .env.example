# Copy this file to .env and fill in your values.

# Path to your Obsidian vault ROOT — the folder that contains the actual
# markdown notes. If your vault lives at V:/Obsidian/Obsidian Vault, set
# that full path, NOT V:/Obsidian (that is the container folder and will
# route notes to the wrong top-level folders).
# Use forward slashes even on Windows.
NORDRUN_VAULT_PATH=V:/Obsidian/Obsidian Vault

# Your Anthropic API key — https://console.anthropic.com/
# Leave blank when using a proxy like 9router.
ANTHROPIC_API_KEY=

# Optional LLM proxy/base URL (e.g. 9router). When set, the Anthropic SDK
# targets this endpoint instead of the default api.anthropic.com.
# NORDRUN_LLM_BASE_URL=http://localhost:20128/v1

# API key for the proxy (used in place of ANTHROPIC_API_KEY when
# NORDRUN_LLM_BASE_URL is set).
# NORDRUN_LLM_API_KEY=

# Which model to call for plugin LLM tasks. Defaults to claude-sonnet-4-6.
NORDRUN_LLM_MODEL=claude-sonnet-4-6

# --- Phase 1: Memory & Knowledge ----------------------------------------
# Embedding provider for memory. "tfidf" (default, no extra dependencies)
# is the only provider in Phase 1. The provider is abstracted, so future
# providers (sentence-transformers, API-based) can be added without code
# changes elsewhere.
# NORDRUN_MEMORY_EMBEDDING_PROVIDER=tfidf

# Cosine similarity threshold for semantic memory retrieval [0.0, 1.0].
# Memories scoring below this are excluded from semantic search results.
# Default 0.0 = return all matches ranked by score.
# NORDRUN_MEMORY_SIMILARITY_THRESHOLD=0.0

# Default number of memories returned by a semantic search.
# NORDRUN_MEMORY_TOP_K=10

# Maximum total memories before consolidation candidates are considered.
# 0 = no limit (Phase 1 default; consolidation is deferred to Phase 2).
# NORDRUN_MEMORY_MAX_RECORDS=0

# Minimum importance for a memory to be injected into LLM context [0.0, 1.0].
# NORDRUN_MEMORY_CONTEXT_MIN_IMPORTANCE=0.3

# Maximum memories injected into a single LLM context window.
# NORDRUN_MEMORY_CONTEXT_MAX_INJECT=5
